---
import { INTERVIEW_VIDEOS, INTERVIEW_RECORDED } from '../data/interview';

const siteUrl = 'https://psyholog-irina.ru';
const first = INTERVIEW_VIDEOS[0];

const embedUrl = (kinescopeId: string, autoplay = false) =>
  `https://kinescope.io/embed/${kinescopeId}?playsinline=1${autoplay ? '&autoplay=1' : ''}`;

const formatDuration = (seconds: number) =>
  `${Math.floor(seconds / 60)}:${String(seconds % 60).padStart(2, '0')}`;

const videoSchema = {
  '@context': 'https://schema.org',
  '@graph': INTERVIEW_VIDEOS.map((v) => ({
    '@type': 'VideoObject',
    name: v.question,
    description: v.transcript,
    thumbnailUrl: `${siteUrl}/video/q${v.id}.jpg`,
    embedUrl: embedUrl(v.kinescopeId),
    uploadDate: INTERVIEW_RECORDED,
    duration: `PT${v.seconds}S`,
    inLanguage: 'ru',
    transcript: v.transcript,
  })),
};
---

<section id="video" style={`padding-top: var(--spacing-fluid-section); padding-bottom: var(--spacing-fluid-section);`}>
  <script type="application/ld+json" set:html={JSON.stringify(videoSchema)} />

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center mb-8 sm:mb-10">
      <p class="text-sage-500 text-sm font-medium tracking-wide uppercase mb-3">Видео</p>
      <h2 class="font-display text-sage-800 text-balance" style={`font-size: var(--text-fluid-3xl);`}>Познакомимся поближе</h2>
      <p class="text-warm-600 max-w-lg mx-auto mt-4 text-pretty">
        Шесть коротких ответов на вопросы, которые чаще всего задают перед первой встречей.
      </p>
    </div>

    <div id="interview" class="grid grid-cols-1 lg:grid-cols-[minmax(0,7fr)_minmax(0,4fr)] gap-5 lg:gap-x-8 lg:gap-y-5">
      <div class="relative rounded-2xl overflow-hidden bg-sage-900 shadow-lg" style={`aspect-ratio: 16 / 9; background: url(/video/q${first.id}.jpg) center / cover;`}>
        <iframe
          data-player
          class="absolute inset-0 w-full h-full border-0"
          src={embedUrl(first.kinescopeId)}
          title={first.question}
          allow="autoplay; fullscreen; picture-in-picture; encrypted-media"
          allowfullscreen
          loading="lazy"
        ></iframe>
      </div>

      <!-- The list takes the player's height on desktop and scrolls inside; below lg it just flows. -->
      <div class="order-3 lg:order-none relative lg:h-full lg:min-h-0">
        <ol class="flex flex-col gap-2 lg:absolute lg:inset-0 lg:overflow-y-auto lg:pr-1 lg:pb-8" style="scrollbar-width: thin;">
          {INTERVIEW_VIDEOS.map((v, i) => (
            <li>
              <button
                type="button"
                id={`video-${v.id}`}
                data-pick={v.id}
                data-src={embedUrl(v.kinescopeId, true)}
                data-title={v.question}
                aria-current={i === 0 ? 'true' : undefined}
                class="group w-full flex items-center gap-3 p-2.5 rounded-xl text-left border border-transparent transition-colors duration-300 hover:bg-white/70 hover:border-sage-100 aria-[current]:bg-white aria-[current]:border-sage-200 aria-[current]:shadow-sm"
              >
                <span class="relative w-24 shrink-0 rounded-lg overflow-hidden bg-sage-900" style="aspect-ratio: 16 / 9;">
                  <img src={`/video/q${v.id}.jpg`} alt="" width="1280" height="720" class="w-full h-full object-cover" loading="lazy" />
                  <span class="absolute bottom-1 right-1 text-[10px] leading-none px-1.5 py-1 rounded bg-black/60 text-white">{formatDuration(v.seconds)}</span>
                </span>
                <span class="min-w-0">
                  <span class="block text-[11px] uppercase tracking-wide text-sage-500 font-medium">Вопрос {v.id}</span>
                  <span class="block text-sage-800 text-sm sm:text-[15px] leading-snug mt-0.5">{v.question}</span>
                </span>
              </button>
            </li>
          ))}
        </ol>
        <div class="hidden lg:block pointer-events-none absolute bottom-0 inset-x-0 h-10 bg-gradient-to-t from-warm-50 to-transparent"></div>
      </div>

      <!-- Every answer stays in the markup so the markdown variant of the page carries all six transcripts. -->
      <div class="order-2 lg:order-none lg:col-start-1">
        {INTERVIEW_VIDEOS.map((v, i) => (
          <div data-answer={v.id} class:list={[i === 0 ? '' : 'hidden']}>
            <div class="flex items-baseline justify-between gap-4">
              <h3 class="font-display text-sage-800 text-xl sm:text-2xl">{v.question}</h3>
              <span class="text-warm-500 text-sm shrink-0">{formatDuration(v.seconds)}</span>
            </div>
            <details class="mt-3 group">
              <summary class="cursor-pointer text-sage-600 text-sm font-medium inline-flex items-center gap-1.5 hover:text-sage-700 select-none">
                Текст ответа
                <svg class="w-4 h-4 transition-transform group-open:rotate-180" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 9l-7 7-7-7" /></svg>
              </summary>
              <p class="mt-3 text-warm-600 leading-relaxed text-pretty">{v.transcript}</p>
            </details>
          </div>
        ))}
      </div>
    </div>
  </div>

  <script is:inline>
    (function () {
      var root = document.getElementById('interview');
      if (!root) return;
      var player = root.querySelector('[data-player]');
      var picks = root.querySelectorAll('[data-pick]');
      var answers = root.querySelectorAll('[data-answer]');

      picks.forEach(function (button) {
        button.addEventListener('click', function () {
          var id = button.dataset.pick;
          picks.forEach(function (b) {
            if (b === button) b.setAttribute('aria-current', 'true');
            else b.removeAttribute('aria-current');
          });
          answers.forEach(function (a) { a.classList.toggle('hidden', a.dataset.answer !== id); });
          button.scrollIntoView({ block: 'nearest' });

          player.title = button.dataset.title;
          player.src = button.dataset.src;
        });
      });

      // links elsewhere on the page point at #video-N to open a particular answer
      function openFromHash() {
        if (!/^#video-\d$/.test(location.hash)) return;
        var wanted = root.querySelector(location.hash);
        if (!wanted) return;
        wanted.click();
        player.parentElement.scrollIntoView({ block: 'center' });
      }
      openFromHash();
      window.addEventListener('hashchange', openFromHash);
    })();
  </script>
</section>

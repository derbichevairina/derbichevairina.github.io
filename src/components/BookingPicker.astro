---
import { DURATION_MIN, PRICE_LABEL, MAX_URL } from '../config';

// Cal.com on this server, reached same-origin through nginx (deploy/nginx)
const CALCOM_ORIGIN = "/cal-api";
---

<!-- Own date → time → form picker on Cal.com's public endpoints (script below). Plain CSS here, not Tailwind
     classes: a class new to the build changes the shared CSS file and its hash on every page. -->
<style is:inline>
  #booking-grid { max-width: 40rem; margin-inline: auto; }
  @media (min-width: 1024px) {
    #booking-grid { max-width: none; grid-template-columns: 22rem minmax(0, 640px); justify-content: center; align-items: start; }
    #booking-grid .bk-price { grid-column: 1; grid-row: 1; }
    #booking-grid #picker { grid-column: 2; grid-row: 1; }
  }
  /* compact price line above the picker on narrow screens, where the full price card sits below the fold */
  .bk-miniprice { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: center; gap: 0.25rem 0.625rem; margin: 0; font-size: 0.9375rem; color: var(--color-warm-500); }
  .bk-miniprice strong { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: var(--color-sage-800); }
  @media (min-width: 1024px) { .bk-miniprice { display: none; } }

  #picker { position: relative; padding: 1.25rem 1rem 1.5rem; color: var(--color-warm-800); }
  @media (min-width: 640px) { #picker { padding: 1.75rem 2rem 2rem; } }
  #picker h3 { font-family: var(--font-display); font-weight: 600; color: var(--color-sage-900); font-size: 1.375rem; line-height: 1.25; outline-style: none; }
  #picker button:focus-visible, #picker a:focus-visible, #picker input:focus-visible { outline-style: solid; outline-width: 2px; outline-color: var(--color-sage-600); outline-offset: 2px; }
  #picker a { color: var(--color-sage-700); text-decoration: underline; text-underline-offset: 2px; }
  .pk-step { animation: pk-in 0.25s var(--ease-snappy); }
  @keyframes pk-in { from { opacity: 0; translate: 0 8px; } }

  /* progress: Дата → Время → Контакты */
  .pk-progress { display: flex; align-items: center; gap: 0.5rem; margin: 0 0 1.5rem; padding: 0; list-style: none; }
  .pk-pstep { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8125rem; color: var(--color-warm-400); transition: color 0.3s; }
  .pk-pnum { display: grid; place-items: center; width: 1.625rem; height: 1.625rem; border-radius: 9999px; border: 1.5px solid var(--color-warm-300); background: #fff; font-size: 0.75rem; font-weight: 600; transition: background 0.3s, border-color 0.3s, color 0.3s; }
  .pk-pstep[data-state="active"] { color: var(--color-sage-800); font-weight: 600; }
  .pk-pstep[data-state="active"] .pk-pnum { background: var(--color-sage-700); border-color: var(--color-sage-700); color: #fff; }
  .pk-pstep[data-state="done"] { color: var(--color-sage-600); }
  .pk-pstep[data-state="done"] .pk-pnum { background: var(--color-sage-100); border-color: var(--color-sage-300); color: var(--color-sage-700); }
  .pk-plink { flex: 1; min-width: 0.75rem; height: 1.5px; background: var(--color-warm-200); transition: background 0.3s; }
  .pk-plink[data-state="done"] { background: var(--color-sage-300); }
  @media (max-width: 400px) { .pk-pstep:not([data-state="active"]) .pk-plabel { display: none; } }


  .pk-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 1rem; }
  .pk-nav { width: 2.5rem; height: 2.5rem; border-radius: 9999px; display: grid; place-items: center; color: var(--color-sage-700); border: 1px solid var(--color-sage-200); background: #fff; transition: background 0.2s, border-color 0.2s, opacity 0.2s; }
  .pk-nav:hover:not(:disabled) { background: var(--color-sage-50); border-color: var(--color-sage-300); }
  .pk-nav:disabled { opacity: 0.35; }
  .pk-grid { display: grid; grid-template-columns: repeat(7, minmax(0, 1fr)); gap: 0.375rem; text-align: center; }
  .pk-wd { font-size: 0.75rem; font-weight: 600; letter-spacing: 0.05em; color: var(--color-warm-400); padding-bottom: 0.25rem; }
  .pk-day, .pk-skel { position: relative; height: clamp(2.5rem, 11vw, 3.25rem); border-radius: 0.75rem; font-size: 1rem; }
  .pk-day { transition: background 0.2s, color 0.2s, box-shadow 0.2s, transform 0.15s; }
  .pk-day:disabled { color: var(--color-warm-300); }
  /* free days are unmistakably tappable */
  .pk-free { background: var(--color-sage-100); box-shadow: inset 0 0 0 1px var(--color-sage-200); color: var(--color-sage-900); font-weight: 600; cursor: pointer; }
  .pk-today { box-shadow: inset 0 0 0 1.5px var(--color-sage-400); }
  .pk-today::after { content: ""; position: absolute; left: 50%; bottom: 0.35rem; width: 0.375rem; height: 0.375rem; margin-left: -0.1875rem; border-radius: 50%; background: var(--color-sage-600); }
  .pk-skel { background: var(--color-warm-100); animation: pk-pulse 0.8s ease-in-out infinite alternate; }
  @keyframes pk-pulse { to { opacity: 0.4; } }
  .pk-back { color: var(--color-sage-700); font-weight: 500; padding: 0.25rem 0; margin-bottom: 0.75rem; }
  .pk-back:hover { text-decoration: underline; }
  .pk-sub { color: var(--color-warm-500); font-size: 0.9375rem; margin-top: 0.375rem; }
  .pk-sel, .pk-sel:disabled { background: var(--color-sage-700); box-shadow: 0 6px 14px -6px var(--color-sage-700); color: #fff; }
  .pk-sel::after { background: #fff; }
  .pk-slots { margin-top: 1.5rem; scroll-margin-top: 5rem; }
  .pk-slots .pk-back { display: block; }
  #picker .pk-dayhead { font-family: var(--font-display); font-size: 1.25rem; font-weight: 600; color: var(--color-sage-900); margin: 0 0 0.25rem; }
  .pk-slotsmeta { display: flex; flex-wrap: wrap; align-items: center; gap: 0.25rem 0.75rem; margin: 0 0 0.875rem; font-size: 0.8125rem; color: var(--color-warm-500); }
  .pk-times { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.625rem; }
  .pk-time { height: 3.25rem; border: 1.5px solid var(--color-sage-300); border-radius: 0.875rem; background: #fff; color: var(--color-sage-800); font-size: 1.0625rem; font-weight: 600; font-variant-numeric: tabular-nums; transition: background 0.2s, border-color 0.2s, color 0.2s, transform 0.15s, box-shadow 0.2s; }
  /* from 768 px the card (640 px) makes room: calendar shrinks, one column of times to its right, no back link */
  @media (min-width: 768px) {
    .pk-pick { display: flex; gap: 2rem; }
    .pk-cal { flex: 1; min-width: 0; }
    /* contain: size keeps the times out of the row's height: the card stays the calendar's height, the list scrolls */
    .pk-slots { flex: none; width: 13rem; margin-top: 0; display: flex; flex-direction: column; contain: size; }
    .pk-times { flex: 1; min-height: 0; grid-template-columns: 1fr; align-content: start; overflow-y: auto; scrollbar-width: thin; scrollbar-color: var(--color-sage-300) transparent; scrollbar-gutter: stable; padding: 3px; margin: -3px; }
    .pk-times.pk-more { -webkit-mask-image: linear-gradient(#000 calc(100% - 2.5rem), transparent); mask-image: linear-gradient(#000 calc(100% - 2.5rem), transparent); }
    .pk-slots .pk-back { display: none; }
    #picker .pk-dayhead { display: flex; align-items: center; height: 2.5rem; margin-bottom: 1rem; font-size: 1.125rem; white-space: nowrap; }
    /* meta shares the weekday row, each time button shares a week row (same height and gap as .pk-day) */
    .pk-slotsmeta { height: 1.375rem; margin-bottom: 0.375rem; }
    .pk-times { gap: 0.375rem; }
  }

  /* time-zone widget under the calendar */
  .pk-tz { position: relative; margin-top: 1.25rem; }
  .pk-tzlabel { font-size: 0.8125rem; font-weight: 600; color: var(--color-warm-700); margin-bottom: 0.25rem; }
  .pk-tzbtn { display: flex; align-items: center; gap: 0.5rem; min-height: 2.75rem; padding: 0 0.5rem; margin-left: -0.5rem; border-radius: 0.75rem; color: var(--color-sage-800); font-size: 0.9375rem; text-align: left; }
  .pk-tzbtn:hover { background: var(--color-sage-50); }
  .pk-tzbtn span { flex: 1; min-width: 0; }
  .pk-tzlist { position: absolute; z-index: 20; left: 0; right: 0; top: 100%; max-height: 16rem; overflow-y: auto; margin-top: 0.25rem; padding: 0.375rem; background: #fff; border: 1px solid var(--color-sage-200); border-radius: 0.75rem; box-shadow: var(--shadow-elevated); }
  .pk-tzlist[hidden] { display: none; }
  .pk-tzlist button { display: block; width: 100%; min-height: 2.75rem; padding: 0 0.75rem; border-radius: 0.5rem; text-align: left; font-size: 0.9375rem; color: var(--color-warm-800); }
  .pk-tzlist button:hover { background: var(--color-sage-50); }
  .pk-tzlist [aria-selected=true] button { background: var(--color-sage-100); font-weight: 600; }

  /* contact step: reassuring summary card + refined form */
  .pk-summary:focus { outline: none; }
  .pk-summary { position: relative; border-radius: 1rem; padding: 0.875rem 1rem; background: var(--color-sage-50); border: 1px solid var(--color-sage-200); color: var(--color-sage-900); }
  .pk-sumlabel { margin: 0 0 0.25rem; font-size: 0.75rem; font-weight: 500; color: var(--color-sage-600); }
  .pk-sumdate { margin: 0; font-size: 1rem; font-weight: 600; line-height: 1.35; }
  .pk-sumtime { margin: 0; font-size: 1rem; font-weight: 600; font-variant-numeric: tabular-nums; line-height: 1.35; }
  .pk-summeta { margin: 0.375rem 0 0; font-size: 0.875rem; color: var(--color-warm-700); }
  .pk-sumzone { margin: 0.125rem 0 0; font-size: 0.8125rem; color: var(--color-warm-500); }
  .pk-sumed { position: absolute; top: 0.75rem; right: 0.75rem; padding: 0.25rem 0.625rem; border-radius: 9999px; border: 1px solid var(--color-sage-300); color: var(--color-sage-700); font-size: 0.8125rem; font-weight: 500; transition: background 0.2s; }
  .pk-sumed:hover { background: #fff; }
  .pk-form { display: grid; gap: 1rem; margin-top: 1.5rem; }
  .pk-form label.pk-field { display: grid; gap: 0.375rem; font-size: 0.875rem; font-weight: 500; color: var(--color-warm-800); }
  .pk-field small { font-weight: 400; color: var(--color-warm-400); }
  .pk-input { height: 3.25rem; padding: 0 1rem; border: 1.5px solid var(--color-warm-200); border-radius: 0.875rem; font-size: 1rem; background: var(--color-warm-50); color: var(--color-warm-900); transition: border-color 0.2s, background 0.2s, box-shadow 0.2s; }
  .pk-input:focus { outline: none; border-color: var(--color-sage-500); background: #fff; box-shadow: 0 0 0 3px var(--color-sage-100); }
  .pk-btn { position: relative; display: inline-flex; align-items: center; justify-content: center; gap: 0.5rem; height: 3.5rem; padding: 0 1.75rem; border-radius: 9999px; background: var(--color-sage-700); color: #fff; font-weight: 600; font-size: 1rem; box-shadow: 0 10px 22px -10px var(--color-sage-700); transition: background 0.2s, transform 0.15s, box-shadow 0.2s; }
  .pk-btn:hover:not(:disabled) { background: var(--color-sage-800); transform: translateY(-1px); box-shadow: 0 14px 26px -10px var(--color-sage-700); }
  .pk-btn:active:not(:disabled) { transform: scale(0.98); }
  .pk-btn:disabled { opacity: 0.6; }
  .pk-btn--submit { width: 100%; }
  .pk-form .pk-consent { display: flex; align-items: flex-start; gap: 0.75rem; min-height: 3rem; padding: 0.875rem 1rem; border-radius: 0.875rem; background: var(--color-warm-50); font-size: 0.9375rem; line-height: 1.45; color: var(--color-warm-700); cursor: pointer; transition: background 0.2s; }
  .pk-consent:has(input:checked) { background: var(--color-sage-50); }
  .pk-consent.pk-err { background: #fbefec; }
  .pk-consent input { flex: none; width: 1.375rem; height: 1.375rem; margin-top: 0.125rem; accent-color: var(--color-sage-700); cursor: pointer; }
  .pk-msg[data-for=consent] { margin-top: -0.375rem; }
  .pk-note { color: var(--color-warm-400); font-size: 0.8125rem; line-height: 1.5; }
  .pk-msg { color: #9b2c2c; background: #fbefec; border-radius: 0.75rem; padding: 0.75rem 1rem; font-size: 0.9375rem; margin-top: 1rem; }
  .pk-form .pk-msg { margin-top: 0; }
  .pk-empty { margin-top: 1.25rem; text-align: center; color: var(--color-warm-500); }
  .pk-empty .pk-btn { margin-top: 0.75rem; }

  /* success */
  .pk-done { text-align: center; padding: 0.75rem 0 0.25rem; }
  .pk-check { display: grid; place-items: center; width: 4.25rem; height: 4.25rem; margin: 0 auto 1.25rem; border-radius: 50%; background: var(--color-sage-100); color: var(--color-sage-700); box-shadow: 0 0 0 8px var(--color-sage-50); }
  @media (prefers-reduced-motion: no-preference) {
    .pk-check { animation: pk-pop 0.45s var(--ease-snappy); }
    .pk-check svg path { stroke-dasharray: 30; stroke-dashoffset: 30; animation: pk-draw 0.5s 0.25s var(--ease-snappy) forwards; }
  }
  @keyframes pk-pop { from { transform: scale(0.6); opacity: 0; } }
  @keyframes pk-draw { to { stroke-dashoffset: 0; } }
  .pk-done h3 { font-size: 1.75rem; margin-bottom: 0.375rem; }
  .pk-done-sub { color: var(--color-warm-500); margin: 0 0 1.5rem; }
  .pk-donecard { max-width: 22rem; margin: 0 auto 1.5rem; padding: 1.125rem 1.25rem; border: 1px solid var(--color-sage-200); border-radius: 1.25rem; background: var(--color-sage-50); }
  .pk-donedate { margin: 0; font-family: var(--font-display); font-size: 1.125rem; font-weight: 600; color: var(--color-sage-900); }
  .pk-donetime { margin: 0.125rem 0 0; font-family: var(--font-display); font-size: 1.5rem; font-weight: 600; font-variant-numeric: tabular-nums; color: var(--color-sage-900); }
  .pk-donemeta { margin: 0.5rem 0 0; font-size: 0.875rem; color: var(--color-warm-600); }
  .pk-donezone { margin: 0.125rem 0 0; font-size: 0.8125rem; color: var(--color-warm-400); }

  /* hover only after the pointer moves: a new step appears under a still pointer, which would paint one button green */
  @media (hover: hover) {
    .pk-moved .pk-free:hover { background: var(--color-sage-700); box-shadow: 0 6px 14px -6px var(--color-sage-700); color: #fff; transform: translateY(-1px); }
    .pk-moved .pk-free:hover::after { background: #fff; }
    .pk-moved .pk-time:hover { background: var(--color-sage-700); border-color: var(--color-sage-700); color: #fff; transform: translateY(-1px); }
  }
  @media (prefers-reduced-motion: reduce) { .pk-step, .pk-skel { animation: none; } }
</style>
<div id="booking-grid" class="grid grid-cols-1 gap-6 lg:gap-10 items-start">
  <p class="bk-miniprice">
    <strong>{PRICE_LABEL}</strong>
    <span>{DURATION_MIN} минут · видеосвязь · онлайн</span>
  </p>

  <div id="picker" class="rounded-2xl bg-white border border-sage-200/70 shadow-soft">
    <ol class="pk-progress" id="pk-progress" aria-label="Шаги записи">
      <li class="pk-pstep" data-step="1" data-state="active"><span class="pk-pnum">1</span><span class="pk-plabel">Дата</span></li>
      <li class="pk-plink" aria-hidden="true"></li>
      <li class="pk-pstep" data-step="2" data-state="todo"><span class="pk-pnum">2</span><span class="pk-plabel">Время</span></li>
      <li class="pk-plink" aria-hidden="true"></li>
      <li class="pk-pstep" data-step="3" data-state="todo"><span class="pk-pnum">3</span><span class="pk-plabel">Контакты</span></li>
    </ol>
    <div id="picker-view"></div>
    <p id="picker-status" class="sr-only" aria-live="polite"></p>
  </div>

  <slot />{/* the side card, class "bk-price": price on the home page, who and what on /zapis/ */}
</div>
<script is:inline define:vars={{ CALCOM_ORIGIN, DURATION_MIN, PRICE_LABEL, MAX_URL }}>
  (() => {
    const HOUR = 3600e3, EVENT_TYPE_ID = 1, DEFAULT_ZONE = "Europe/Moscow";
    const ZONE_NAMES = { "Europe/Moscow": "Москва", "Europe/Kaliningrad": "Калининград", "Asia/Yekaterinburg": "Екатеринбург", "Asia/Novosibirsk": "Новосибирск", "Asia/Vladivostok": "Владивосток", "Asia/Tbilisi": "Тбилиси", "Asia/Yerevan": "Ереван", "Asia/Almaty": "Алматы", "Europe/Istanbul": "Стамбул", "Asia/Dubai": "Дубай", "Europe/Berlin": "Берлин", "Europe/London": "Лондон", "America/New_York": "Нью-Йорк" };
    const picker = document.getElementById("picker"), view = document.getElementById("picker-view"), status = document.getElementById("picker-status"), progress = document.getElementById("pk-progress");
    const contacts = `<a href="${MAX_URL}" target="_blank" rel="noopener">MAX</a>, ` + '<a href="https://t.me/derbichevairina" target="_blank" rel="noopener">Telegram</a> или <a href="https://wa.me/+79028983895" target="_blank" rel="noopener">WhatsApp</a>';
    const detectedZone = Intl.DateTimeFormat().resolvedOptions().timeZone || DEFAULT_ZONE;
    const zones = [...new Set([detectedZone, DEFAULT_ZONE, ...Object.keys(ZONE_NAMES)])]; // an unknown detected zone is listed as is
    let zone = detectedZone, month, monthSlots = {}, day = null, slot = null, pickId = 0;
    let initialLoad = true, skipTries = 0; // on first load we skip months without free time
    const slotsByMonth = {}; // "zone|2026-10" → promise of { "2026-10-07": [{ time }] }, only days with free slots
    const contact = { name: "", email: "", phone: "+7" };

    const pad = (n) => String(n).padStart(2, "0");
    const upperFirst = (s) => s[0].toUpperCase() + s.slice(1);
    const isWide = () => matchMedia("(min-width: 768px)").matches;
    // wall-clock parts of an instant in a zone
    const zonedParts = (ms, tz) => Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: tz, hourCycle: "h23", year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "numeric", second: "numeric" }).formatToParts(ms).map((p) => [p.type, Number(p.value)]));
    const offsetMs = (ms, tz) => { const p = zonedParts(ms, tz); return Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second) - Math.floor(ms / 1000) * 1000; };
    const instantOfZonedMidnight = (y, m, tz) => { const wall = Date.UTC(y, m, 1); return wall - offsetMs(wall - offsetMs(wall, tz), tz); }; // m: 0-based; two passes cross a DST change
    const monthKey = ({ y, m }) => `${y}-${pad(m + 1)}`;
    const daysIn = ({ y, m }) => new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
    const formatDay = (key, options) => new Date(key + "T12:00:00Z").toLocaleDateString("ru-RU", { timeZone: "UTC", ...options });
    const dayTitle = (key) => upperFirst(formatDay(key, { weekday: "long", day: "numeric", month: "long" }));
    const clock = (ms) => new Date(ms).toLocaleTimeString("ru-RU", { timeZone: zone, hour: "2-digit", minute: "2-digit" });
    const slotRange = (time) => `${clock(Date.parse(time))}–${clock(Date.parse(time) + HOUR)}`;
    const zoneLabel = (tz, withClock) => {
      const minutes = Math.round(offsetMs(Date.now(), tz) / 60000), abs = Math.abs(minutes);
      const utc = `UTC${minutes < 0 ? "−" : "+"}${Math.floor(abs / 60)}${abs % 60 ? ":" + pad(abs % 60) : ""}`;
      const time = withClock ? `, ${new Date().toLocaleTimeString("ru-RU", { timeZone: tz, hour: "2-digit", minute: "2-digit" })}` : "";
      return `${ZONE_NAMES[tz] || tz.split("/").pop().replace(/_/g, " ")} (${utc})${time}`;
    };
    const today = () => { const p = zonedParts(Date.now(), zone); return { key: `${p.year}-${pad(p.month)}-${pad(p.day)}`, month: { y: p.year, m: p.month - 1 } }; };
    const back = (to, label, extra = "") => `<button type="button" class="pk-back ${extra}" data-go="${to}">← ${label}</button>`;
    month = today().month;

    const CHECK = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
    const ARROW = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>';

    // step: 1 date, 2 time, 3 contacts, 4 done
    function setProgress(step) {
      progress.querySelectorAll(".pk-pstep").forEach((li) => {
        const n = Number(li.dataset.step);
        const state = step > n || step === 4 ? "done" : step === n ? "active" : "todo";
        li.dataset.state = state;
        li.querySelector(".pk-pnum").innerHTML = state === "done" ? CHECK : String(n);
        if (state === "active") li.setAttribute("aria-current", "step"); else li.removeAttribute("aria-current");
      });
      progress.querySelectorAll(".pk-plink").forEach((link, i) => { link.dataset.state = step > i + 1 || step === 4 ? "done" : "todo"; });
    }

    function loadMonthSlots(m) {
      const key = `${zone}|${monthKey(m)}`, tz = zone;
      if (!slotsByMonth[key]) {
        const next = { y: m.y + Math.floor((m.m + 1) / 12), m: (m.m + 1) % 12 };
        const input = { json: { eventTypeId: EVENT_TYPE_ID, startTime: new Date(instantOfZonedMidnight(m.y, m.m, tz)).toISOString(), endTime: new Date(instantOfZonedMidnight(next.y, next.m, tz) - 1000).toISOString(), timeZone: tz } };
        slotsByMonth[key] = fetch(`${CALCOM_ORIGIN}/api/trpc/slots/getSchedule?input=${encodeURIComponent(JSON.stringify(input))}`)
          .then((r) => { if (!r.ok) throw new Error(`slots ${r.status}`); return r.json(); })
          .then((body) => body.result.data.json.slots)
          .catch((e) => { delete slotsByMonth[key]; throw e; });
      }
      return slotsByMonth[key];
    }

    function fadeTimesIfMore() { // the soft bottom edge shows while the times column has more below
      const times = view.querySelector(".pk-times");
      if (times) times.classList.toggle("pk-more", times.scrollTop + times.clientHeight < times.scrollHeight - 1);
    }

    // focusSelector: null on page load (no scroll jump), the step heading on a step change
    function show(html, announcement, focusSelector, isNewStep) {
      view.innerHTML = `<div class="${isNewStep ? "pk-step" : ""}">${html}</div>`;
      picker.classList.remove("pk-moved");
      status.textContent = announcement;
      fadeTimesIfMore();
      const target = focusSelector && view.querySelector(focusSelector);
      if (target) (target.disabled ? view.querySelector("[tabindex]") : target).focus();
    }

    const chevron = (d) => `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
    const globe = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>';

    function zoneSelectHtml(suffix) {
      const options = zones.map((tz) => `<li role="option" aria-selected="${tz === zone}"><button type="button" data-tz="${tz}">${zoneLabel(tz, true)}</button></li>`).join("");
      return `<div class="pk-tz">`
        + `<p class="pk-tzlabel" id="pk-tzlabel-${suffix}">Часовой пояс</p>`
        + `<button type="button" id="pk-tzbtn-${suffix}" class="pk-tzbtn" data-go="tz" aria-haspopup="listbox" aria-expanded="false" aria-label="Часовой пояс: ${zoneLabel(zone)}">${globe}<span>${zoneLabel(zone, true)}</span>${chevron("M5.5 8 10 12.5 14.5 8")}</button>`
        + `<ul class="pk-tzlist" role="listbox" aria-label="Часовой пояс" hidden>${options}</ul></div>`;
    }

    function slotsColumnHtml() {
      const times = monthSlots[day] || [];
      return `<div class="pk-slots" id="pk-slots">${back("calendar", "Выбрать другую дату")}<h4 class="pk-dayhead">${dayTitle(day)}</h4>`
        + `<p class="pk-slotsmeta">${DURATION_MIN} минут · видеосвязь</p>`
        + `<div class="pk-times">${times.map((s) => `<button type="button" class="pk-time" data-time="${s.time}" aria-label="${dayTitle(day)}, ${slotRange(s.time)}">${clock(Date.parse(s.time))}</button>`).join("")}</div></div>`;
    }

    function pickHtml(slots, note) {
      const title = upperFirst(formatDay(`${monthKey(month)}-01`, { month: "long" })) + " " + month.y;
      const first = today(), isFirst = month.y === first.month.y && month.m === first.month.m;
      let cells = ["ПН", "ВТ", "СР", "ЧТ", "ПТ", "СБ", "ВС"].map((d) => `<div class="pk-wd" aria-hidden="true">${d}</div>`).join("");
      cells += "<div></div>".repeat((new Date(Date.UTC(month.y, month.m, 1)).getUTCDay() + 6) % 7);
      for (let d = 1; d <= daysIn(month); d++) {
        const key = `${monthKey(month)}-${pad(d)}`, free = slots?.[key]?.length > 0, isToday = key === first.key, selected = key === day;
        const label = formatDay(key, { day: "numeric", month: "long" }) + (isToday ? ", сегодня" : "") + (free ? ", есть время" : ", нет времени");
        cells += slots
          ? `<button type="button" class="pk-day${free ? " pk-free" : ""}${isToday ? " pk-today" : ""}${selected ? " pk-sel" : ""}" data-day="${key}" aria-label="${label}" aria-pressed="${selected}"${free ? "" : " disabled"}>${d}</button>`
          : '<div class="pk-skel"></div>';
      }
      const empty = slots && !Object.keys(slots).length
        ? '<div class="pk-empty"><p>В этом месяце свободного времени нет.</p><button type="button" class="pk-btn" data-go="next">Следующий месяц</button></div>'
        : "";
      return (note ? `<p class="pk-msg" role="alert">${note}</p>` : "") + '<div class="pk-pick"><div class="pk-cal">'
        + `<div class="pk-head"><button type="button" id="pk-prev" class="pk-nav" data-go="prev" aria-label="Предыдущий месяц"${isFirst ? " disabled" : ""}>${chevron("M12.5 4.5 7 10l5.5 5.5")}</button>`
        + `<h3 tabindex="-1">${title}</h3><button type="button" id="pk-next" class="pk-nav" data-go="next" aria-label="Следующий месяц">${chevron("M7.5 4.5 13 10l-5.5 5.5")}</button></div>`
        + `<div class="pk-grid"${slots ? "" : ' aria-busy="true"'}>${cells}</div>${empty}${zoneSelectHtml("cal")}</div>${day && slots ? slotsColumnHtml() : ""}</div>`;
    }

    async function showPick(focusSelector, isNewStep, note = "") {
      const id = ++pickId;
      show(pickHtml(null, note), "Загружаем расписание", focusSelector, isNewStep);
      let slots;
      try { slots = await loadMonthSlots(month); } catch {
        if (id === pickId) show(`<h3 tabindex="-1">Расписание</h3><p class="pk-msg">Не удалось загрузить расписание — напишите в ${contacts}.</p>`, "Не удалось загрузить расписание", focusSelector);
        return;
      }
      if (id !== pickId) return; // the visitor already moved to another month or zone
      monthSlots = slots;
      if (!slots[day]?.length) day = null; // the day is no longer free
      // first visit: never open on a dead month — walk forward to the first month that has time
      const upcoming = Object.keys(slots).filter((k) => k >= today().key).sort();
      if (initialLoad && !upcoming.length && skipTries < 3) {
        skipTries++;
        const m = month.m + 1;
        month = { y: month.y + Math.floor(m / 12), m: m % 12 };
        return showPick(focusSelector, isNewStep, note);
      }
      initialLoad = false;
      const freeDays = Object.keys(slots).length;
      show(pickHtml(slots, note), freeDays ? `Дней со свободным временем: ${freeDays}` : "В этом месяце свободного времени нет", focusSelector);
      setProgress(day ? 2 : 1);
    }

    function selectDay(key) {
      day = key;
      show(pickHtml(monthSlots), `${dayTitle(day)}, свободных времён: ${monthSlots[day].length}`, null);
      setProgress(2);
      view.querySelector(".pk-sel")?.focus({ preventScroll: true });
      if (!isWide()) document.getElementById("pk-slots").scrollIntoView({ behavior: "smooth", block: "start" });
    }

    function showForm() {
      setProgress(3);
      show(back("pick", "Выбрать другое время")
        + `<div class="pk-summary" tabindex="-1"><p class="pk-sumlabel">Ваша встреча</p>`
        + `<p class="pk-sumdate">${dayTitle(day)}</p><p class="pk-sumtime">${slotRange(slot)}</p>`
        + `<p class="pk-summeta">${DURATION_MIN} минут · видеосвязь · ${PRICE_LABEL}</p><p class="pk-sumzone">${zoneLabel(zone)}</p>`
        + `<button type="button" class="pk-sumed" data-go="pick">Изменить</button></div>`
        + '<form class="pk-form"><label class="pk-field">Имя<input class="pk-input" name="name" required autocomplete="name"></label>'
        + '<label class="pk-field">Электронная почта<input class="pk-input" name="email" type="email" required autocomplete="email"></label>'
        + '<label class="pk-field">Телефон <small>необязательно</small><input class="pk-input" name="phone" type="tel" autocomplete="tel"></label>'
        + '<p class="pk-msg" role="alert" hidden></p>'
        + '<label class="pk-consent"><input type="checkbox" name="consent" required><span>Даю <a href="/soglasie/" target="_blank" rel="noopener">согласие на обработку персональных данных</a> и подтверждаю, что ознакомлен(а) с <a href="/privacy/" target="_blank" rel="noopener">политикой обработки персональных данных</a></span></label>'
        + '<p class="pk-msg" data-for="consent" role="alert" hidden>Чтобы записаться, поставьте галочку: нужно согласие на обработку персональных данных.</p>'
        + `<button class="pk-btn pk-btn--submit"><span class="pk-btn-label">Записаться</span>${ARROW}</button>`
        + '<p class="pk-note">Подтверждение придёт на почту. Если планы изменятся, в письме можно перенести или отменить встречу.</p></form>', "Заполните контакты", ".pk-summary", true);
      const form = view.querySelector("form");
      for (const field in contact) form.elements.namedItem(field).value = contact[field];
    }

    async function book(form) {
      const button = form.querySelector(".pk-btn"), label = button.querySelector(".pk-btn-label"), message = form.querySelector(".pk-msg");
      const phone = contact.phone.replace(/[^\d+]/g, ""), start = Date.parse(slot);
      button.disabled = true; label.textContent = "Отправляем…"; message.hidden = true;
      const response = await fetch(`${CALCOM_ORIGIN}/api/book/event`, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          responses: { name: contact.name.trim(), email: contact.email.trim(), ...(phone.length > 2 && { attendeePhoneNumber: phone }) },
          start: new Date(start).toISOString(), end: new Date(start + HOUR).toISOString(), eventTypeId: EVENT_TYPE_ID, timeZone: zone, language: "ru", metadata: { consent: "soglasie-v1", consentAt: new Date().toISOString() },
        }),
      }).catch(() => null);
      if (response?.ok || response?.status === 409) delete slotsByMonth[`${zone}|${monthKey(month)}`]; // the slot is now held
      if (response?.ok) {
        setProgress(4);
        return show(`<div class="pk-done"><div class="pk-check"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>`
          + `<h3 tabindex="-1">Вы записаны</h3><p class="pk-done-sub">Подтверждение придёт на почту, которую вы указали.</p>`
          + `<div class="pk-donecard"><p class="pk-donedate">${dayTitle(day)}</p><p class="pk-donetime">${slotRange(slot)}</p>`
          + `<p class="pk-donemeta">${DURATION_MIN} минут · видеосвязь · ${PRICE_LABEL}</p><p class="pk-donezone">${zoneLabel(zone)}</p></div>`
          + `<p class="pk-note">Перенести или отменить встречу можно по ссылке из письма или написав в ${contacts}.</p></div>`, "", "h3", true); // the focused heading is read out, an announcement would repeat it
      }
      if (response?.status === 409) return showPick("h3", true, "Это время уже занято — выберите другое.");
      const problem = response?.status === 400 ? (await response.json().catch(() => ({}))).message || "" : "";
      message.innerHTML = /email/.test(problem) ? "Проверьте адрес электронной почты."
        : /phone/i.test(problem) ? "Проверьте номер телефона."
        : /name/.test(problem) ? "Укажите имя."
        : `Не получилось записаться — напишите в ${contacts}.`;
      message.hidden = false; button.disabled = false; label.textContent = "Записаться";
    }

    const closeZoneLists = () => {
      view.querySelectorAll(".pk-tzlist").forEach((list) => {
        if (!list.hidden) {
          list.hidden = true;
          list.closest(".pk-tz").querySelector(".pk-tzbtn").setAttribute("aria-expanded", "false");
        }
      });
    };
    view.addEventListener("scroll", fadeTimesIfMore, true); // scroll does not bubble
    new ResizeObserver(fadeTimesIfMore).observe(picker); // a size change (window, fonts) moves the end of the list
    picker.addEventListener("pointermove", () => picker.classList.add("pk-moved"));
    document.addEventListener("click", (e) => { if (!e.target.closest(".pk-tz")) closeZoneLists(); });
    view.addEventListener("keydown", (e) => {
      if (e.key !== "Escape") return;
      const open = view.querySelector(".pk-tzlist:not([hidden])");
      if (open) { closeZoneLists(); open.closest(".pk-tz").querySelector(".pk-tzbtn").focus(); }
    });
    view.addEventListener("input", (e) => { if (e.target.name in contact) contact[e.target.name] = e.target.value; });
    view.addEventListener("invalid", (e) => { // does not bubble; preventDefault drops the browser bubble, our message is the only one
      if (e.target.name !== "consent") return;
      e.preventDefault();
      e.target.closest(".pk-consent").classList.add("pk-err");
      e.target.form.querySelector("[data-for=consent]").hidden = false;
      if (!e.target.form.querySelector(":invalid:not([name=consent])")) e.target.focus();
    }, true);
    view.addEventListener("change", (e) => {
      if (e.target.name !== "consent") return;
      e.target.closest(".pk-consent").classList.remove("pk-err");
      e.target.form.querySelector("[data-for=consent]").hidden = e.target.checked;
    });
    view.addEventListener("submit", (e) => { e.preventDefault(); book(e.target); });
    view.addEventListener("click", (e) => {
      const button = e.target.closest("button[type=button]");
      if (!button) return;
      const { go, day: pickedDay, time, tz } = button.dataset;
      if (go === "prev" || go === "next") {
        const m = month.m + (go === "prev" ? -1 : 1);
        month = { y: month.y + Math.floor(m / 12), m: (m + 12) % 12 };
        day = null;
        showPick(button.id ? `#${button.id}` : "h3");
      } else if (go === "tz") {
        const list = button.closest(".pk-tz").querySelector(".pk-tzlist"), open = list.hidden;
        closeZoneLists();
        if (open) {
          list.hidden = false; button.setAttribute("aria-expanded", "true");
          list.querySelector("[aria-selected=true] button").focus();
        }
      } else if (tz) {
        zone = tz; day = null;
        const first = today().month;
        if (month.y * 12 + month.m < first.y * 12 + first.m) month = first;
        showPick("#pk-tzbtn-cal");
      } else if (go === "calendar") {
        view.querySelector(".pk-cal").scrollIntoView({ behavior: "smooth", block: "start" });
        view.querySelector(".pk-sel")?.focus({ preventScroll: true });
      } else if (go === "pick") showPick("h3", true);
      else if (pickedDay) selectDay(pickedDay);
      else if (time) { slot = time; showForm(); }
    });

    showPick(null);
  })();
</script>

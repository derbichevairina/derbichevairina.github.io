      <p class="text-warm-500 text-xs text-center mt-6">
        Тестовая версия: запись не настоящая. Записаться сейчас можно в
        <a href="https://t.me/derbichevairina" target="_blank" rel="noopener" class="underline hover:text-sage-700">Telegram</a> или
        <a href="https://wa.me/+79028983895" target="_blank" rel="noopener" class="underline hover:text-sage-700">WhatsApp</a>.
      </p>
      <script is:inline define:vars={{ CALCOM_ORIGIN, DURATION_MIN, PRICE_LABEL }}>
        (() => {
          const HOUR = 3600e3, EVENT_TYPE_ID = 1, DEFAULT_ZONE = "Europe/Moscow";
          const ZONE_NAMES = { "Europe/Moscow": "Москва", "Europe/Kaliningrad": "Калининград", "Asia/Yekaterinburg": "Екатеринбург", "Asia/Novosibirsk": "Новосибирск", "Asia/Vladivostok": "Владивосток", "Asia/Tbilisi": "Тбилиси", "Asia/Yerevan": "Ереван", "Asia/Almaty": "Алматы", "Europe/Istanbul": "Стамбул", "Asia/Dubai": "Дубай", "Europe/Berlin": "Берлин", "Europe/London": "Лондон", "America/New_York": "Нью-Йорк" };
          const picker = document.getElementById("picker"), view = document.getElementById("picker-view"), status = document.getElementById("picker-status"), progress = document.getElementById("pk-progress");
          const contacts = '<a href="https://t.me/derbichevairina" target="_blank" rel="noopener">Telegram</a> или <a href="https://wa.me/+79028983895" target="_blank" rel="noopener">WhatsApp</a>';
          const detectedZone = Intl.DateTimeFormat().resolvedOptions().timeZone || DEFAULT_ZONE;
          const zones = [...new Set([detectedZone, DEFAULT_ZONE, ...Object.keys(ZONE_NAMES)])]; // an unknown detected zone is listed as is
          let zone = detectedZone, month, monthSlots = {}, day = null, slot = null, pickId = 0, pendingDay = null;
          let initialLoad = true, skipTries = 0; // on first load we skip months without free time
          const slotsByMonth = {}; // "zone|2026-10" → promise of { "2026-10-07": [{ time }] }, only days with free slots
          let zoneSlots = {}; // merged free days of every loaded month for the current zone — feeds the quick-pick chips
          const contact = { name: "", email: "", phone: "+7" };

          const pad = (n) => String(n).padStart(2, "0");
          const upperFirst = (s) => s[0].toUpperCase() + s.slice(1);
          const isWide = () => matchMedia("(min-width: 768px)").matches;
          // wall-clock parts of an instant in a zone
          const zonedParts = (ms, tz) => Object.fromEntries(new Intl.DateTimeFormat("en-CA", { timeZone: tz, hourCycle: "h23", year: "numeric", month: "numeric", day: "numeric", hour: "numeric", minute: "numeric", second: "numeric" }).formatToParts(ms).map((p) => [p.type, Number(p.value)]));
          const offsetMs = (ms, tz) => { const p = zonedParts(ms, tz); return Date.UTC(p.year, p.month - 1, p.day, p.hour, p.minute, p.second) - Math.floor(ms / 1000) * 1000; };
          const instantOfZonedMidnight = (y, m, tz) => { const wall = Date.UTC(y, m, 1); return wall - offsetMs(wall - offsetMs(wall, tz), tz); }; // m: 0-based; two passes cross a DST change
          const monthKey = ({ y, m }) => `${y}-${pad(m + 1)}`;
          const daysIn = ({ y, m }) => new Date(Date.UTC(y, m + 1, 0)).getUTCDate();
          const formatDay = (key, options) => new Date(key + "T12:00:00Z").toLocaleDateString("ru-RU", { timeZone: "UTC", ...options });
          const dayTitle = (key) => upperFirst(formatDay(key, { weekday: "long", day: "numeric", month: "long" }));
          const clock = (ms) => new Date(ms).toLocaleTimeString("ru-RU", { timeZone: zone, hour: "2-digit", minute: "2-digit" });
          const slotRange = (time) => `${clock(Date.parse(time))}–${clock(Date.parse(time) + HOUR)}`;
          const zoneLabel = (tz, withClock) => {
            const minutes = Math.round(offsetMs(Date.now(), tz) / 60000), abs = Math.abs(minutes);
            const utc = `UTC${minutes < 0 ? "−" : "+"}${Math.floor(abs / 60)}${abs % 60 ? ":" + pad(abs % 60) : ""}`;
            const time = withClock ? `, ${new Date().toLocaleTimeString("ru-RU", { timeZone: tz, hour: "2-digit", minute: "2-digit" })}` : "";
            return `${ZONE_NAMES[tz] || tz.split("/").pop().replace(/_/g, " ")} (${utc})${time}`;
          };
          const today = () => { const p = zonedParts(Date.now(), zone); return { key: `${p.year}-${pad(p.month)}-${pad(p.day)}`, month: { y: p.year, m: p.month - 1 } }; };
          const back = (to, label, extra = "") => `<button type="button" class="pk-back ${extra}" data-go="${to}">← ${label}</button>`;
          month = today().month;

          const CHECK = '<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>';
          const ARROW = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6"/></svg>';

          // step: 1 date, 2 time, 3 contacts, 4 done
          function setProgress(step) {
            progress.querySelectorAll(".pk-pstep").forEach((li) => {
              const n = Number(li.dataset.step);
              const state = step > n || step === 4 ? "done" : step === n ? "active" : "todo";
              li.dataset.state = state;
              li.querySelector(".pk-pnum").innerHTML = state === "done" ? CHECK : String(n);
              if (state === "active") li.setAttribute("aria-current", "step"); else li.removeAttribute("aria-current");
            });
            progress.querySelectorAll(".pk-plink").forEach((link, i) => { link.dataset.state = step > i + 1 || step === 4 ? "done" : "todo"; });
          }

          function loadMonthSlots(m) {
            const key = `${zone}|${monthKey(m)}`, tz = zone;
            if (!slotsByMonth[key]) {
              const next = { y: m.y + Math.floor((m.m + 1) / 12), m: (m.m + 1) % 12 };
              const input = { json: { eventTypeId: EVENT_TYPE_ID, startTime: new Date(instantOfZonedMidnight(m.y, m.m, tz)).toISOString(), endTime: new Date(instantOfZonedMidnight(next.y, next.m, tz) - 1000).toISOString(), timeZone: tz } };
              slotsByMonth[key] = fetch(`${CALCOM_ORIGIN}/api/trpc/slots/getSchedule?input=${encodeURIComponent(JSON.stringify(input))}`)
                .then((r) => { if (!r.ok) throw new Error(`slots ${r.status}`); return r.json(); })
                .then((body) => body.result.data.json.slots)
                .catch((e) => { delete slotsByMonth[key]; throw e; });
            }
            return slotsByMonth[key];
          }

          function fadeTimesIfMore() { // the soft bottom edge shows while the times column has more below
            const times = view.querySelector(".pk-times");
            if (times) times.classList.toggle("pk-more", times.scrollTop + times.clientHeight < times.scrollHeight - 1);
          }

          // focusSelector: null on page load (no scroll jump), the step heading on a step change
          function show(html, announcement, focusSelector, isNewStep) {
            view.innerHTML = `<div class="${isNewStep ? "pk-step" : ""}">${html}</div>`;
            picker.classList.remove("pk-moved");
            status.textContent = announcement;
            fadeTimesIfMore();
            const target = focusSelector && view.querySelector(focusSelector);
            if (target) (target.disabled ? view.querySelector("[tabindex]") : target).focus();
          }

          const chevron = (d) => `<svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="${d}"/></svg>`;
          const globe = '<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3c2.5 2.6 3.8 5.6 3.8 9S14.5 18.4 12 21c-2.5-2.6-3.8-5.6-3.8-9S9.5 5.6 12 3z"/></svg>';

          function zoneSelectHtml(suffix) {
            const options = zones.map((tz) => `<li role="option" aria-selected="${tz === zone}"><button type="button" data-tz="${tz}">${zoneLabel(tz, true)}</button></li>`).join("");
            return `<div class="pk-tz">`
              + `<p class="pk-tzlabel" id="pk-tzlabel-${suffix}">Часовой пояс</p>`
              + `<button type="button" id="pk-tzbtn-${suffix}" class="pk-tzbtn" data-go="tz" aria-haspopup="listbox" aria-expanded="false" aria-label="Часовой пояс: ${zoneLabel(zone)}">${globe}<span>${zoneLabel(zone, true)}</span>${chevron("M5.5 8 10 12.5 14.5 8")}</button>`
              + `<ul class="pk-tzlist" role="listbox" aria-label="Часовой пояс" hidden>${options}</ul></div>`;
          }

          function chipsHtml() {
            const first = today().key;
            const days = Object.keys(zoneSlots).filter((k) => k >= first && zoneSlots[k]?.length).sort().slice(0, 3);
            if (!days.length) return "";
            const chips = days.map((k) => {
              const label = formatDay(k, { weekday: "short", day: "numeric", month: "short" }).replace(/\.$/, "");
              return `<button type="button" class="pk-chip${k === day ? " pk-chip--sel" : ""}" data-chip="${k}">${label}<span class="pk-chip-time">с ${clock(Date.parse(zoneSlots[k][0].time))}</span></button>`;
            }).join("");
            return `<div class="pk-chips"><p class="pk-chips-label">Ближайшее свободное время</p>${chips}</div>`;
          }

          function slotsColumnHtml() {
            const times = monthSlots[day] || [];
            return `<div class="pk-slots" id="pk-slots">${back("calendar", "Выбрать другую дату")}<h4 class="pk-dayhead">${dayTitle(day)}</h4>`
              + `<p class="pk-slotsmeta">${DURATION_MIN} минут · видеосвязь</p>`
              + `<div class="pk-times">${times.map((s) => `<button type="button" class="pk-time" data-time="${s.time}" aria-label="${dayTitle(day)}, ${slotRange(s.time)}">${clock(Date.parse(s.time))}</button>`).join("")}</div></div>`;
          }

          function pickHtml(slots, note) {
            const title = upperFirst(formatDay(`${monthKey(month)}-01`, { month: "long" })) + " " + month.y;
            const first = today(), isFirst = month.y === first.month.y && month.m === first.month.m;
            let cells = ["ПН", "ВТ", "СР", "ЧТ", "ПТ", "СБ", "ВС"].map((d) => `<div class="pk-wd" aria-hidden="true">${d}</div>`).join("");
            cells += "<div></div>".repeat((new Date(Date.UTC(month.y, month.m, 1)).getUTCDay() + 6) % 7);
            for (let d = 1; d <= daysIn(month); d++) {
              const key = `${monthKey(month)}-${pad(d)}`, free = slots?.[key]?.length > 0, isToday = key === first.key, selected = key === day;
              const label = formatDay(key, { day: "numeric", month: "long" }) + (isToday ? ", сегодня" : "") + (free ? ", есть время" : ", нет времени");
              cells += slots
                ? `<button type="button" class="pk-day${free ? " pk-free" : ""}${isToday ? " pk-today" : ""}${selected ? " pk-sel" : ""}" data-day="${key}" aria-label="${label}" aria-pressed="${selected}"${free ? "" : " disabled"}>${d}</button>`
                : '<div class="pk-skel"></div>';
            }
            const empty = slots && !Object.keys(slots).length
              ? '<div class="pk-empty"><p>В этом месяце свободного времени нет.</p><button type="button" class="pk-btn" data-go="next">Следующий месяц</button></div>'
              : "";
            return (note ? `<p class="pk-msg" role="alert">${note}</p>` : "") + (slots ? chipsHtml() : "") + '<div class="pk-pick"><div class="pk-cal">'
              + `<div class="pk-head"><button type="button" id="pk-prev" class="pk-nav" data-go="prev" aria-label="Предыдущий месяц"${isFirst ? " disabled" : ""}>${chevron("M12.5 4.5 7 10l5.5 5.5")}</button>`
              + `<h3 tabindex="-1">${title}</h3><button type="button" id="pk-next" class="pk-nav" data-go="next" aria-label="Следующий месяц">${chevron("M7.5 4.5 13 10l-5.5 5.5")}</button></div>`
              + `<div class="pk-grid"${slots ? "" : ' aria-busy="true"'}>${cells}</div>${empty}${zoneSelectHtml("cal")}</div>${day && slots ? slotsColumnHtml() : ""}</div>`;
          }

          async function showPick(focusSelector, isNewStep, note = "") {
            const id = ++pickId;
            show(pickHtml(null, note), "Загружаем расписание", focusSelector, isNewStep);
            let slots;
            try { slots = await loadMonthSlots(month); } catch {
              if (id === pickId) show(`<h3 tabindex="-1">Расписание</h3><p class="pk-msg">Не удалось загрузить расписание — напишите в ${contacts}.</p>`, "Не удалось загрузить расписание", focusSelector);
              return;
            }
            if (id !== pickId) return; // the visitor already moved to another month or zone
            monthSlots = slots;
            zoneSlots = { ...zoneSlots, ...slots };
            if (!slots[day]?.length) day = null; // the day is no longer free
            // first visit: never open on a dead month — walk forward to the first month that has time
            const upcoming = Object.keys(slots).filter((k) => k >= today().key).sort();
            if (initialLoad && !upcoming.length && skipTries < 3) {
              skipTries++;
              const m = month.m + 1;
              month = { y: month.y + Math.floor(m / 12), m: m % 12 };
              return showPick(focusSelector, isNewStep, note);
            }
            initialLoad = false;
            const freeDays = Object.keys(slots).length;
            show(pickHtml(slots, note), freeDays ? `Дней со свободным временем: ${freeDays}` : "В этом месяце свободного времени нет", focusSelector);
            setProgress(day ? 2 : 1);
            if (pendingDay && slots[pendingDay]?.length) {
              const key = pendingDay;
              pendingDay = null;
              selectDay(key, { scroll: false, focusDay: false });
            }
          }

          function selectDay(key, { scroll = true, focusDay = true } = {}) {
            day = key;
            show(pickHtml(monthSlots), `${dayTitle(day)}, свободных времён: ${monthSlots[day].length}`, null);
            setProgress(2);
            if (focusDay) view.querySelector(".pk-sel")?.focus({ preventScroll: true });
            if (scroll && !isWide()) document.getElementById("pk-slots").scrollIntoView({ behavior: "smooth", block: "start" });
          }

          function showForm() {
            setProgress(3);
            show(back("pick", "Выбрать другое время")
              + `<div class="pk-summary" tabindex="-1"><p class="pk-sumlabel">Ваша встреча</p>`
              + `<p class="pk-sumdate">${dayTitle(day)}</p><p class="pk-sumtime">${slotRange(slot)}</p>`
              + `<p class="pk-summeta">${DURATION_MIN} минут · видеосвязь · ${PRICE_LABEL}</p><p class="pk-sumzone">${zoneLabel(zone)}</p>`
              + `<button type="button" class="pk-sumed" data-go="pick">Изменить</button></div>`
              + '<form class="pk-form"><label class="pk-field">Имя<input class="pk-input" name="name" required autocomplete="name"></label>'
              + '<label class="pk-field">Электронная почта<input class="pk-input" name="email" type="email" required autocomplete="email"></label>'
              + '<label class="pk-field">Телефон <small>необязательно</small><input class="pk-input" name="phone" type="tel" autocomplete="tel"></label>'
              + '<p class="pk-msg" role="alert" hidden></p>'
              + '<label class="pk-consent"><input type="checkbox" name="consent" required><span>Даю <a href="/soglasie/" target="_blank" rel="noopener">согласие на обработку персональных данных</a> и подтверждаю, что ознакомлен(а) с <a href="/privacy/" target="_blank" rel="noopener">политикой обработки персональных данных</a></span></label>'
              + '<p class="pk-msg" data-for="consent" role="alert" hidden>Чтобы записаться, поставьте галочку: нужно согласие на обработку персональных данных.</p>'
              + `<button class="pk-btn pk-btn--submit"><span class="pk-btn-label">Записаться</span>${ARROW}</button>`
              + '<p class="pk-note">Это заявка, а не оплата: я свяжусь с вами, чтобы подтвердить время.</p></form>', "Заполните контакты", ".pk-summary", true);
            const form = view.querySelector("form");
            for (const field in contact) form.elements.namedItem(field).value = contact[field];
          }

          async function book(form) {
            const button = form.querySelector(".pk-btn"), label = button.querySelector(".pk-btn-label"), message = form.querySelector(".pk-msg");
            const phone = contact.phone.replace(/[^\d+]/g, ""), start = Date.parse(slot);
            button.disabled = true; label.textContent = "Отправляем…"; message.hidden = true;
            const response = await fetch(`${CALCOM_ORIGIN}/api/book/event`, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                responses: { name: contact.name.trim(), email: contact.email.trim(), ...(phone.length > 2 && { attendeePhoneNumber: phone }) },
                start: new Date(start).toISOString(), end: new Date(start + HOUR).toISOString(), eventTypeId: EVENT_TYPE_ID, timeZone: zone, language: "ru", metadata: { consent: "soglasie-v1", consentAt: new Date().toISOString() },
              }),
            }).catch(() => null);
            if (response?.ok || response?.status === 409) delete slotsByMonth[`${zone}|${monthKey(month)}`]; // the slot is now held
            if (response?.ok) {
              setProgress(4);
              return show(`<div class="pk-done"><div class="pk-check"><svg width="30" height="30" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg></div>`
                + `<h3 tabindex="-1">Заявка отправлена</h3><p class="pk-done-sub">Ирина свяжется с вами, чтобы подтвердить время.</p>`
                + `<div class="pk-donecard"><p class="pk-donedate">${dayTitle(day)}</p><p class="pk-donetime">${slotRange(slot)}</p>`
                + `<p class="pk-donemeta">${DURATION_MIN} минут · видеосвязь · ${PRICE_LABEL}</p><p class="pk-donezone">${zoneLabel(zone)}</p></div>`
                + `<p class="pk-note">Если планы изменятся, напишите в ${contacts}.</p></div>`, "", "h3", true); // the focused heading is read out, an announcement would repeat it
            }
            if (response?.status === 409) return showPick("h3", true, "Это время уже занято — выберите другое.");
            const problem = response?.status === 400 ? (await response.json().catch(() => ({}))).message || "" : "";
            message.innerHTML = /email/.test(problem) ? "Проверьте адрес электронной почты."
              : /phone/i.test(problem) ? "Проверьте номер телефона."
              : /name/.test(problem) ? "Укажите имя."
              : `Не получилось отправить заявку — напишите в ${contacts}.`;
            message.hidden = false; button.disabled = false; label.textContent = "Записаться";
          }

          const closeZoneLists = () => {
            view.querySelectorAll(".pk-tzlist").forEach((list) => {
              if (!list.hidden) {
                list.hidden = true;
                list.closest(".pk-tz").querySelector(".pk-tzbtn").setAttribute("aria-expanded", "false");
              }
            });
          };
          view.addEventListener("scroll", fadeTimesIfMore, true); // scroll does not bubble
          new ResizeObserver(fadeTimesIfMore).observe(picker); // a size change (window, fonts) moves the end of the list
          picker.addEventListener("pointermove", () => picker.classList.add("pk-moved"));
          document.addEventListener("click", (e) => { if (!e.target.closest(".pk-tz")) closeZoneLists(); });
          view.addEventListener("keydown", (e) => {
            if (e.key !== "Escape") return;
            const open = view.querySelector(".pk-tzlist:not([hidden])");
            if (open) { closeZoneLists(); open.closest(".pk-tz").querySelector(".pk-tzbtn").focus(); }
          });
          view.addEventListener("input", (e) => { if (e.target.name in contact) contact[e.target.name] = e.target.value; });
          view.addEventListener("invalid", (e) => { // does not bubble; preventDefault drops the browser bubble, our message is the only one
            if (e.target.name !== "consent") return;
            e.preventDefault();
            e.target.closest(".pk-consent").classList.add("pk-err");
            e.target.form.querySelector("[data-for=consent]").hidden = false;
            if (!e.target.form.querySelector(":invalid:not([name=consent])")) e.target.focus();
          }, true);
          view.addEventListener("change", (e) => {
            if (e.target.name !== "consent") return;
            e.target.closest(".pk-consent").classList.remove("pk-err");
            e.target.form.querySelector("[data-for=consent]").hidden = e.target.checked;
          });
          view.addEventListener("submit", (e) => { e.preventDefault(); book(e.target); });
          view.addEventListener("click", (e) => {
            const button = e.target.closest("button[type=button]");
            if (!button) return;
            const { go, day: pickedDay, time, tz, chip } = button.dataset;
            if (go === "prev" || go === "next") {
              const m = month.m + (go === "prev" ? -1 : 1);
              month = { y: month.y + Math.floor(m / 12), m: (m + 12) % 12 };
              day = null;
              showPick(button.id ? `#${button.id}` : "h3");
            } else if (go === "tz") {
              const list = button.closest(".pk-tz").querySelector(".pk-tzlist"), open = list.hidden;
              closeZoneLists();
              if (open) {
                list.hidden = false; button.setAttribute("aria-expanded", "true");
                list.querySelector("[aria-selected=true] button").focus();
              }
            } else if (tz) {
              zone = tz; day = null; zoneSlots = {};
              const first = today().month;
              if (month.y * 12 + month.m < first.y * 12 + first.m) month = first;
              showPick("#pk-tzbtn-cal");
            } else if (chip) {
              const [y, m] = chip.split("-").map(Number);
              if (y === month.y && m === month.m + 1 && monthSlots[chip]?.length) selectDay(chip);
              else { month = { y, m: m - 1 }; day = null; pendingDay = chip; showPick(null); }
            } else if (go === "calendar") {
              view.querySelector(".pk-cal").scrollIntoView({ behavior: "smooth", block: "start" });
              view.querySelector(".pk-sel")?.focus({ preventScroll: true });
            } else if (go === "pick") showPick("h3", true);
            else if (pickedDay) selectDay(pickedDay);
            else if (time) { slot = time; showForm(); }
          });

          showPick(null);
        })();
      </script>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8" style="padding-bottom: var(--spacing-fluid-section);">
    <div class="relative overflow-hidden rounded-3xl bg-sage-900 text-center p-8 sm:p-14 lg:p-20 reveal">
      <div class="absolute -top-24 -left-24 w-72 h-72 bg-sage-700/50 rounded-full blur-3xl"></div>
      <div class="absolute -bottom-24 -right-24 w-72 h-72 bg-sage-600/40 rounded-full blur-3xl"></div>

      <div class="relative z-10">
        <h2 class="font-display text-white text-balance mb-4" style="font-size: var(--text-fluid-3xl);">
          Запишитесь на первую сессию
        </h2>
        <p class="text-sage-300 max-w-md mx-auto mb-9 text-pretty">
          Первая встреча — это знакомство. Она ни к чему вас не обязывает.
        </p>

        <div class="flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-4">

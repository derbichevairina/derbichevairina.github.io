---
import Base from '../layouts/Base.astro';
import { SESSION_LABEL } from '../config';

const contactPageSchema = {
  "@context": "https://schema.org",
  "@type": "ContactPage",
  "name": "Контакты — Ирина Дербичева",
  "url": "https://psyholog-irina.ru/kontakty/",
  "mainEntity": {
    "@type": "Person",
    "name": "Ирина Дербичева",
    "jobTitle": "Экзистенциальный психолог, ACT-терапевт",
    "url": "https://psyholog-irina.ru",
    "telephone": "+79028983895",
    "sameAs": [
      "https://t.me/derbichevairina",
      "https://wa.me/+79028983895",
    ],
  },
};
---

<Base
  title="Контакты — записаться к психологу Ирине Дербичевой"
  description="Как связаться и записаться на консультацию: Telegram, WhatsApp, онлайн-запись. Формат встреч, стоимость, с чем я работаю и с чем не работаю."
>
  <script type="application/ld+json" set:html={JSON.stringify(contactPageSchema)} />

  <section class="relative overflow-hidden">
    <div class="absolute top-10 -right-32 w-96 h-96 bg-sage-200/30 rounded-full blur-3xl"></div>

    <div class="relative max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <nav class="text-sm text-warm-400 mb-8">
        <a href="/" class="hover:text-sage-600 transition-colors">Главная</a>
        <span class="mx-2">/</span>
        <span class="text-warm-600">Контакты</span>
      </nav>

      <h1 class="font-display text-3xl sm:text-4xl lg:text-5xl font-medium text-sage-900 leading-tight mb-6 text-balance">
        Контакты
      </h1>
      <p class="text-lg text-warm-600 leading-relaxed text-pretty">
        Меня зовут Ирина Дербичева, я клинический психолог. Работаю с взрослыми людьми
        индивидуально и только онлайн. Написать можно в любое время — я отвечаю в течение дня.
      </p>
    </div>
  </section>

  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <h2 class="font-display text-2xl sm:text-3xl text-sage-800 mb-8">Как связаться</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
        <a
          href="https://t.me/derbichevairina"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-4 p-5 bg-sage-50 rounded-xl hover:bg-sage-100 transition-colors duration-300"
        >
          <svg class="w-7 h-7 flex-shrink-0 text-sage-700" viewBox="0 0 24 24" fill="currentColor"><path d="M11.944 0A12 12 0 0 0 0 12a12 12 0 0 0 12 12 12 12 0 0 0 12-12A12 12 0 0 0 12 0a12 12 0 0 0-.056 0zm4.962 7.224c.1-.002.321.023.465.14a.506.506 0 0 1 .171.325c.016.093.036.306.02.472-.18 1.898-.962 6.502-1.36 8.627-.168.9-.499 1.201-.82 1.23-.696.065-1.225-.46-1.9-.902-1.056-.693-1.653-1.124-2.678-1.8-1.185-.78-.417-1.21.258-1.91.177-.184 3.247-2.977 3.307-3.23.007-.032.014-.15-.056-.212s-.174-.041-.249-.024c-.106.024-1.793 1.14-5.061 3.345-.48.33-.913.49-1.302.48-.428-.008-1.252-.241-1.865-.44-.752-.245-1.349-.374-1.297-.789.027-.216.325-.437.893-.663 3.498-1.524 5.83-2.529 6.998-3.014 3.332-1.386 4.025-1.627 4.476-1.635z"/></svg>
          <div>
            <div class="text-sage-800 font-medium">Telegram</div>
            <div class="text-warm-500 text-sm">@derbichevairina</div>
          </div>
        </a>

        <a
          href="https://wa.me/+79028983895"
          target="_blank"
          rel="noopener"
          class="flex items-center gap-4 p-5 bg-sage-50 rounded-xl hover:bg-sage-100 transition-colors duration-300"
        >
          <svg class="w-7 h-7 flex-shrink-0 text-sage-700" viewBox="0 0 24 24" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
          <div>
            <div class="text-sage-800 font-medium">WhatsApp</div>
            <div class="text-warm-500 text-sm">+7 902 898-38-95</div>
          </div>
        </a>
      </div>

      <p class="text-warm-500 text-sm mt-6">
        Если удобнее сразу выбрать время, не переписываясь, — на главной странице есть
        <a href="/#booking" class="text-sage-600 hover:text-sage-700 underline underline-offset-2 transition-colors">календарь свободных слотов</a>.
      </p>
    </div>
  </section>

  <section class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
    <h2 class="font-display text-2xl sm:text-3xl text-sage-800 mb-8">Формат работы</h2>
    <dl class="space-y-5 text-warm-600 leading-relaxed">
      <div>
        <dt class="text-sage-800 font-medium">Где проходят встречи</dt>
        <dd>Онлайн, по видеосвязи. Очных консультаций я не провожу. Часовой пояс подбираем удобный для вас — я работаю с клиентами из России и из-за рубежа.</dd>
      </div>
      <div>
        <dt class="text-sage-800 font-medium">Сколько длится и сколько стоит</dt>
        <dd>Одна сессия — {SESSION_LABEL}.</dd>
      </div>
      <div>
        <dt class="text-sage-800 font-medium">Как часто</dt>
        <dd>Обычно раз в неделю. Первая встреча — знакомство: вы рассказываете о своей ситуации, я объясняю, чем могу быть полезна. Она ни к чему не обязывает, продолжать или нет — решаете вы.</dd>
      </div>
      <div>
        <dt class="text-sage-800 font-medium">Как отменить или перенести</dt>
        <dd>Напишите в Telegram или WhatsApp заранее — подберём другое время.</dd>
      </div>
    </dl>
  </section>

  <section class="bg-white">
    <div class="max-w-3xl mx-auto px-4 sm:px-6 lg:px-8 py-16 sm:py-20">
      <h2 class="font-display text-2xl sm:text-3xl text-sage-800 mb-8">С чем я работаю и с чем нет</h2>

      <div class="grid grid-cols-1 sm:grid-cols-2 gap-8">
        <div>
          <h3 class="text-sage-800 font-medium mb-4">Работаю</h3>
          <ul class="space-y-2.5 text-warm-600 text-sm">
            <li><a href="/trevoga/" class="text-sage-600 hover:text-sage-700 underline underline-offset-2 transition-colors">Тревога и панические атаки</a></li>
            <li><a href="/rpp/" class="text-sage-600 hover:text-sage-700 underline underline-offset-2 transition-colors">Расстройства пищевого поведения</a></li>
            <li><a href="/otnosheniya/" class="text-sage-600 hover:text-sage-700 underline underline-offset-2 transition-colors">Отношения и расставания</a></li>
            <li><a href="/emigratsiya/" class="text-sage-600 hover:text-sage-700 underline underline-offset-2 transition-colors">Эмиграция и адаптация</a></li>
            <li><a href="/vygoranie/" class="text-sage-600 hover:text-sage-700 underline underline-offset-2 transition-colors">Эмоциональное выгорание</a></li>
            <li><a href="/samootsenka/" class="text-sage-600 hover:text-sage-700 underline underline-offset-2 transition-colors">Самооценка и уверенность</a></li>
            <li>Поиск смысла, экзистенциальные кризисы</li>
          </ul>
        </div>

        <div>
          <h3 class="text-sage-800 font-medium mb-4">Не работаю</h3>
          <ul class="space-y-2.5 text-warm-600 text-sm">
            <li>С детьми и подростками — только со взрослыми</li>
            <li>С парами и семьями — только индивидуально</li>
            <li>Не назначаю лекарства: это работа врача-психиатра</li>
            <li>Не веду экстренную помощь в кризисных состояниях — в такой ситуации нужна очная или круглосуточная служба</li>
          </ul>
        </div>
      </div>
    </div>
  </section>
</Base>
